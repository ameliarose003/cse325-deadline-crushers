@page "/login"
@rendermode @(new Microsoft.AspNetCore.Components.Web.InteractiveServerRenderMode(prerender: false))
@using Momentum.Services
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Momentum - Login</PageTitle>

<div class="login-page-wrapper">
    <div class="login-page-container">
        <div class="login-header">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="login-logo"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
            <h1>Welcome Back</h1>
            <p>Sign in to your account</p>
        </div>

        @if (registered == true && string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert-success">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                Registration successful! Please sign in.
            </div>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert-danger">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                @errorMessage
            </div>
        }

        <form @onsubmit="HandleSubmit" class="login-form" @onsubmit:preventDefault>
            <div class="form-group">
                <div class="input-wrapper">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="input-icon"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                    <input type="email" id="email" @bind="email" placeholder="Email Address" required />
                </div>
            </div>
            <div class="form-group">
                <div class="input-wrapper">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="input-icon"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                    <input type="password" id="password" @bind="password" placeholder="Password" required minlength="8" />
                </div>
            </div>
            <button type="submit" class="btn-signin">
                <span>Sign In</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </button>
        </form>

        <a href="/register" class="register-link">
            Don't have an account? <span>Register now</span>
        </a>
    </div>
</div>

@code {
    private string email = string.Empty;
    private string password = string.Empty;
    private string? errorMessage;

    [SupplyParameterFromQuery]
    private bool? registered { get; set; }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Please enter both email and password.";
            return;
        }

        if (password.Length < 8)
        {
            errorMessage = "Password must be at least 8 characters.";
            return;
        }

        if (!email.Contains("@"))
        {
            errorMessage = "Please enter a valid email address.";
            return;
        }

        var success = await AuthService.LoginAsync(email, password);
        if (success)
        {
            // Clear any registration parameter from the URL state, and navigate to home
            NavigationManager.NavigateTo("/");
        }
        else
        {
            errorMessage = "Invalid email or password.";
        }
    }
}