@page "/"
@rendermode InteractiveServer
@using Momentum.Models
@using Momentum.Services
@inject IHabitService HabitService
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Momentum - Dashboard</PageTitle>

@if (isAuthenticated)
{
    <div class="dashboard-container">
        @* Greeting Header *@
        <header class="dashboard-header">
            <div class="welcome-msg">
                <h1>Good @TimeOfDayGreeting, @userEmail!</h1>
                <p>Ready to maintain your momentum and crush your goals today?</p>
            </div>
            <div style="display: flex; gap: 0.75rem; align-items: center;">
                <div class="date-badge">
                    📅 @TodayDateFormatted
                </div>
                <button class="btn-dev" @onclick="HandleSignOut" style="border-color: #f87171; color: #ef4444; border-radius: 9999px; padding: 0.5rem 1rem;">
                    Sign Out
                </button>
            </div>
        </header>

        @if (habits.Count > 0)
        {
            @* Overview Stat Cards *@
            <section class="stats-grid">
                <div class="stat-card">
                    <div class="stat-header">
                        <span class="stat-label">Current Streak</span>
                        <div class="stat-icon icon-streak">🔥</div>
                    </div>
                    <div>
                        <div class="stat-value">@stats.CurrentStreak Days</div>
                        <div class="stat-desc">Personal Record: @stats.LongestStreak Days</div>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-header">
                        <span class="stat-label">Daily Progress</span>
                        <div class="stat-icon icon-completion">✅</div>
                    </div>
                    <div>
                        <div class="stat-value">@stats.CompletionRate%</div>
                        <div class="stat-desc">@stats.CompletedCount of @stats.TotalCount completed today</div>
                        <div class="progress-bar-container">
                            <div class="progress-bar-fill" style="width: @stats.CompletionRate%"></div>
                        </div>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-header">
                        <span class="stat-label">Active Habits</span>
                        <div class="stat-icon icon-habits">📋</div>
                    </div>
                    <div>
                        <div class="stat-value">@stats.TotalCount</div>
                        <div class="stat-desc">Strengthening your daily routines</div>
                    </div>
                </div>
            </section>

            @* Main Dashboard Grid *@
            <div class="dashboard-content-grid">
                @* Left Column: Daily Habits Quick-View *@
                <section class="dashboard-panel">
                    <h2 class="panel-title">
                        <span>⚡ Daily Habits Quick-View</span>
                    </h2>
                    <div class="habit-list-container">
                        @foreach (var habit in habits)
                        {
                            <div class="habit-item @(habit.IsCompleted ? "completed" : "")" @onclick="() => ToggleHabit(habit)">
                                <div class="habit-checkbox">
                                    <svg class="habit-checkbox-icon" viewBox="0 0 24 24">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                </div>
                                <div class="habit-details">
                                    <span class="habit-name">@habit.Name</span>
                                    <div class="habit-meta">
                                        <span class="badge-tag @habit.Category">@habit.CategoryLabel</span>
                                        <span class="habit-streak-badge">🔥 @habit.Streak d</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </section>

                @* Right Column: Streak Highlights Panel *@
                <aside class="dashboard-panel">
                    <h2 class="panel-title">
                        <span>📅 Streak Highlights</span>
                    </h2>
                    
                    @* Weekly Calendar Strip *@
                    <div class="weekly-calendar-grid">
                        @foreach (var day in weekDays)
                        {
                            <div class="calendar-day-col">
                                <span class="calendar-day-lbl">@day.Abbreviation</span>
                                <div class="calendar-day-circle @(day.IsCompleted ? "completed" : "") @(day.IsToday ? "today" : "")" 
                                     title="@day.Name @(day.IsToday ? "(Today)" : "")">
                                    @(day.IsCompleted ? "✓" : day.Name[0])
                                </div>
                            </div>
                        }
                    </div>

                    @* Recent Achievements *@
                    <div class="achievements-section">
                        <h3 class="panel-title" style="font-size: 1rem; margin-bottom: 1rem;">🏆 Recent Achievements</h3>
                        <div class="achievements-list">
                            <div class="achievement-item">
                                <span class="achievement-icon">⚡</span>
                                <div class="achievement-info">
                                    <span class="achievement-title">Consistent Starter</span>
                                    <span class="achievement-desc">Completed at least 3 habits in a single day.</span>
                                </div>
                            </div>
                            <div class="achievement-item" style="border-left-color: #f97316;">
                                <span class="achievement-icon">🔥</span>
                                <div class="achievement-info">
                                    <span class="achievement-title">5-Day Heat</span>
                                    <span class="achievement-desc">Maintained a 5-day habit streak.</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </aside>
            </div>
        }
        else
        {
            @* Empty State Illustration *@
            <section class="empty-state-card">
                <svg class="empty-state-svg" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="100" cy="100" r="80" fill="#e0e7ff" opacity="0.4" />
                    <circle cx="100" cy="100" r="60" fill="#e0e7ff" />
                    <rect x="75" y="65" width="50" height="70" rx="6" fill="white" stroke="#6366f1" stroke-width="4" />
                    <line x1="87" y1="85" x2="113" y2="85" stroke="#94a3b8" stroke-width="3" stroke-linecap="round" />
                    <line x1="87" y1="100" x2="113" y2="100" stroke="#94a3b8" stroke-width="3" stroke-linecap="round" />
                    <line x1="87" y1="115" x2="103" y2="115" stroke="#94a3b8" stroke-width="3" stroke-linecap="round" />
                    <circle cx="100" cy="135" r="22" fill="#818cf8" />
                    <path d="M93 135L98 140L108 130" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <h3>No habits tracked today</h3>
                <p>You haven't set up any habits to track yet. Start building your daily momentum by creating a habit!</p>
                <button class="btn-primary-dashboard" @onclick="LoadMockHabits">
                    Create a Habit
                </button>
            </section>
        }

        @* Controls for Developer testing / Reviewing *@
        <footer class="dev-controls">
            <span>🔧 Review Controls (Simulation)</span>
            <div class="dev-buttons">
                <button class="btn-dev" @onclick="LoadMockHabits">Populate Dashboard</button>
                <button class="btn-dev" @onclick="ClearAllHabits">Empty State View</button>
            </div>
        </footer>
    </div>
}

@code {
    // Authentication Guard State
    private bool isAuthenticated;
    private string userEmail = string.Empty;

    // Dynamic Header values
    private string TimeOfDayGreeting => DateTime.Now.Hour < 12 ? "morning" : (DateTime.Now.Hour < 18 ? "afternoon" : "evening");
    private string TodayDateFormatted => DateTime.Now.ToString("dddd, MMMM d, yyyy");

    // Component State
    private List<Habit> habits = new();
    private List<WeekDay> weekDays = new();
    private OverviewStats stats = new();

    protected override async Task OnInitializedAsync()
    {
        isAuthenticated = await AuthService.IsAuthenticatedAsync();
        if (!isAuthenticated)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        var email = await AuthService.GetCurrentUserEmailAsync();
        userEmail = email ?? "John";

        await LoadDashboardDataAsync();
    }

    private async Task LoadDashboardDataAsync()
    {
        habits = await HabitService.GetTodayHabitsAsync();
        weekDays = await HabitService.GetWeeklyCalendarAsync();
        stats = await HabitService.GetOverviewStatsAsync();
    }

    private async Task ToggleHabit(Habit habit)
    {
        await HabitService.ToggleHabitCompletionAsync(habit.Id);
        await LoadDashboardDataAsync();
    }

    private async Task LoadMockHabits()
    {
        await HabitService.PopulateMockHabitsAsync();
        await LoadDashboardDataAsync();
    }

    private async Task ClearAllHabits()
    {
        await HabitService.ResetAllHabitsAsync();
        await LoadDashboardDataAsync();
    }

    private async Task HandleSignOut()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("/login");
    }
}