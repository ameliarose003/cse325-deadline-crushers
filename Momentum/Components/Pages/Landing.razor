@page "/"
@layout Momentum.Components.Layout.LandingLayout
@rendermode @(new Microsoft.AspNetCore.Components.Web.InteractiveServerRenderMode(prerender: false))
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Momentum - Build Habits, Maintain Momentum</PageTitle>

<div class="landing-container">
    @* Navigation Bar *@
    <nav class="landing-nav animate-fade-in">
        <div class="nav-brand">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="brand-logo"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
            <span class="brand-name">Momentum</span>
        </div>
        <div class="nav-actions">
            <a href="/login" class="btn-nav-secondary">Sign In</a>
            <a href="/register" class="btn-nav-primary">Get Started</a>
        </div>
    </nav>

    @* Hero Section *@
    <header class="hero-section">
        <div class="hero-content">
            <span class="hero-badge animate-slide-up">✨ Build Routines, Achieve More</span>
            <h1 class="hero-title animate-slide-up">
                Build Habits.<br />
                <span class="text-gradient">Maintain Momentum.</span>
            </h1>
            <p class="hero-subtitle animate-slide-up">
                A premium, distraction-free habit tracker designed to help you organize your daily routines, celebrate streaks, and reach your goals.
            </p>
            <div class="hero-ctas animate-slide-up">
                <a href="/register" class="btn-hero-primary">Get Started for Free</a>
                <a href="#features" class="btn-hero-secondary">Explore Features</a>
            </div>
        </div>

        @* Visual Preview / Mockup *@
        <div class="hero-visual animate-fade-in-right">
            <div class="preview-card-wrapper">
                <div class="preview-glass-card">
                    <div class="preview-card-header">
                        <span class="preview-dot red"></span>
                        <span class="preview-dot yellow"></span>
                        <span class="preview-dot green"></span>
                        <span class="preview-card-title">My Dashboard</span>
                    </div>
                    <div class="preview-card-body">
                        <div class="preview-stats-grid">
                            <div class="preview-stat-card">
                                <div class="p-stat-icon">🔥</div>
                                <div class="p-stat-info">
                                    <span class="p-stat-val">5 Days</span>
                                    <span class="p-stat-lbl">Current Streak</span>
                                </div>
                            </div>
                            <div class="preview-stat-card">
                                <div class="p-stat-icon">✅</div>
                                <div class="p-stat-info">
                                    <span class="p-stat-val">80%</span>
                                    <span class="p-stat-lbl">Daily Progress</span>
                                </div>
                            </div>
                        </div>
                        <div class="preview-checklist">
                            <div class="checklist-item checked">
                                <span class="chk-box">✓</span>
                                <span class="chk-txt">Morning Meditation (15 min)</span>
                            </div>
                            <div class="checklist-item checked">
                                <span class="chk-box">✓</span>
                                <span class="chk-txt">Drink 3L of Water</span>
                            </div>
                            <div class="checklist-item">
                                <span class="chk-box"></span>
                                <span class="chk-txt">Read 20 Pages of Book</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    @* Features Section *@
    <section id="features" class="features-section">
        <div class="section-header">
            <h2 class="section-title">Designed for Consistent Progress</h2>
            <p class="section-desc">We combine elegant simplicity with powerful statistics to keep you motivated every single day.</p>
        </div>

        <div class="features-grid">
            @* Feature 1 *@
            <div class="feature-card">
                <div class="feature-icon bg-indigo">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
                </div>
                <h3>Daily Checklist</h3>
                <p>An intuitive quick-view checkbox layout that allows you to complete and log your habits in a single tap.</p>
            </div>

            @* Feature 2 *@
            <div class="feature-card">
                <div class="feature-icon bg-rose">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path></svg>
                </div>
                <h3>Streak Highlights</h3>
                <p>Stay motivated with streak counters and dynamic heat indicators that visualizes your weekly calendar completion.</p>
            </div>

            @* Feature 3 *@
            <div class="feature-card">
                <div class="feature-icon bg-violet">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
                </div>
                <h3>Overview Stats</h3>
                <p>Monitor your progress with interactive analytics, active habit trends, and completion rate calculations.</p>
            </div>
        </div>
    </section>

    @* Call to Action Footer Section *@
    <section class="cta-section">
        <div class="cta-card">
            <h2>Ready to build unstoppable momentum?</h2>
            <p>Join today and start building the routines that will define your success.</p>
            <a href="/register" class="btn-cta-primary">Create Your Free Account</a>
        </div>
    </section>

    @* Footer *@
    <footer class="landing-footer">
        <p>&copy; @DateTime.Now.Year Momentum. All rights reserved.</p>
    </footer>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            NavigationManager.NavigateTo("/dashboard");
        }
    }
}
